# CashPe - Apache configuration
# In Docker, Apache's document root is already /var/www/html/public (see Dockerfile).
# This file protects the repository root layout for local setups (XAMPP etc.).

# Force HTTPS (Render terminates TLS and forwards X-Forwarded-Proto)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Root-level requests are served from /public
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]

# Block direct access to sensitive files and directories
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
<FilesMatch "(^composer\.(json|lock)$|^render\.yaml$|^Dockerfile$)">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/(config|includes|vendor)/

# Security headers
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
