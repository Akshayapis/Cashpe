# CashPe environment configuration
# Copy to .env and fill in your values. NEVER commit the real .env

# --- Application ---
APP_URL=https://cashpe.onrender.com
APP_ENV=production
# 32+ char random string used for AES-256 encryption of provider session tokens
ENCRYPTION_KEY=change-me-to-a-long-random-string
COMMISSION_PERCENT=2

# --- Firebase (Firestore) ---
# Full service account JSON on ONE line (recommended for Render)
FIREBASE_CREDENTIALS_JSON=
# ...or path to the JSON file (local dev)
FIREBASE_CREDENTIALS_PATH=

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP (PHPMailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@cashpe.onrender.com
SMTP_FROM_NAME=CashPe

# --- Admin panel (admin.php) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# --- Personal provider endpoints (optional) ---
# PhonePe Personal / Paytm Personal / Navi transaction APIs are not officially
# published. If you have configured endpoints (e.g. via a partner agreement or
# a self-hosted bridge), set them here. Leave empty to keep those providers
# in "not configured" state - business providers and the SMS-forwarder
# auto-verify flow work without these.
PHONEPE_PERSONAL_BASE_URL=
PAYTM_PERSONAL_BASE_URL=
NAVI_PERSONAL_BASE_URL=
